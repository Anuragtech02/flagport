{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flagport",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Needed by LaunchDarkly's evaluator package (node:events).
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public" },
  // Keeps the workers.dev address working after a custom domain is added
  // (see "Custom domain" in the README). Without this, adding one turns it off.
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ENV_DO", "class_name": "EnvironmentDO" },
      { "name": "REGISTRY", "class_name": "RegistryDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EnvironmentDO", "RegistryDO"] }],
  "observability": { "enabled": true }
}
